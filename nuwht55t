function checkPassword(){

    const password =
        document.getElementById("password").value;

    const error =
        document.getElementById("loginError");

    if(password === "777"){

        document.getElementById("loginScreen")
            .classList.add("hidden");

        document.getElementById("userScreen")
            .classList.remove("hidden");

    }else{

        error.textContent =
            "الباسورد غلط ❌ حاول تاني";

    }

}


/* Enter للدخول */

document
.getElementById("password")
.addEventListener("keydown",function(e){

    if(e.key === "Enter"){
        checkPassword();
    }

});


/* =========================
   USER NAME
========================= */

function startWebsite(){

    const name =
        document.getElementById("visitorName")
        .value.trim();

    const error =
        document.getElementById("nameError");

    if(name === ""){

        error.textContent =
            "اكتب اسمك الأول 👀";

        return;
    }

    document.getElementById("welcomeName")
        .textContent = name;

    document.getElementById("userScreen")
        .classList.add("hidden");

    document.getElementById("website")
        .style.display = "block";

    window.scrollTo(0,0);

}


/* =========================
   QUIZ
========================= */

function checkQuiz(){

    let score = 0;

    for(let i=1;i<=7;i++){

        const answer =
            document.querySelector(
                'input[name="q'+i+'"]:checked'
            );

        if(answer){
            score += Number(answer.value);
        }

    }

    const result =
        document.getElementById("quizResult");

    if(score === 7){

        result.innerHTML =
        "🔥 جامد! 7/7 — إجاباتك كلها صحيحة.";

    }else if(score >= 5){

        result.innerHTML =
        "⚡ ممتاز! نتيجتك "+score+"/7";

    }else if(score >= 3){

        result.innerHTML =
        "💻 كويس، نتيجتك "+score+"/7 — كمل تعلم.";

    }else{

        result.innerHTML =
        "🛡️ نتيجتك "+score+"/7 — الأمن السيبراني محتاج ممارسة وتعلم.";

    }

}


/* =========================
   TOP BUTTON
========================= */

window.addEventListener("scroll",function(){

    const btn =
        document.getElementById("topBtn");

    if(window.scrollY > 500){
        btn.style.display = "block";
    }else{
        btn.style.display = "none";
    }

});

</script>


