    0 0 35px rgba(0,255,80,.12),
    inset 0 0 30px rgba(0,255,80,.03);

    backdrop-filter:blur(18px);

    animation:boxIn 1s ease;
}

@keyframes boxIn{

    from{
        opacity:0;
        transform:translateY(40px) scale(.9);
    }

    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }

