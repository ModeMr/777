/* =========================
   BACKGROUND
========================= */

body::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-3;

    background:
    radial-gradient(circle at 20% 10%,rgba(0,255,80,.13),transparent 30%),
    radial-gradient(circle at 80% 80%,rgba(0,180,60,.08),transparent 35%),
    #010403;
}

body::after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-2;

    background-image:
    linear-gradient(rgba(0,255,80,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,255,80,.035) 1px,transparent 1px);

    background-size:40px 40px;

    animation:gridMove 12s linear infinite;
}

@keyframes gridMove{
    from{
        background-position:0 0;
    }

    to{
        background-position:0 40px;
    }
}

/* =========================
   MATRIX
========================= */

.matrix{
    position:fixed;
    inset:0;
    z-index:-1;
    pointer-events:none;
    opacity:.12;
    overflow:hidden;
}

.matrix span{
    position:absolute;
    top:-100px;
    color:#00ff66;
    font-size:15px;
    animation:matrixFall linear infinite;
}

@keyframes matrixFall{

    0%{
        transform:translateY(-100px);
        opacity:0;
    }

    20%{
        opacity:1;
    }

    100%{
        transform:translateY(110vh);
        opacity:0;
    }

}

/* =========================
   COMMON
========================= */

.hidden{
    display:none !important;
}

.container{
